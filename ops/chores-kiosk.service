[Unit]
Description=Chores Kiosk UI
After=chores-backend.service
# Kiosk starts X directly from console login, no need for graphical.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/chores_app/current
Environment="DISPLAY=:0"
# Run the Kiosk module (via startx / .xinitrc)
ExecStart=/usr/bin/startx
StandardOutput=journal+console
StandardError=journal+console
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
