/* Sci-Fi HUD Theme - Web Admin Alignment (Roboto/White/dark-blue) */

/* Global Reset */
QWidget {
    font-family: 'Roboto', 'Verdana', sans-serif;
    font-size: 16px;
    color: #FFFFFF; /* Pure White Text */
    background-color: transparent;
}

/* Main Window Background */
QMainWindow {
    background-color: #050510;
    border-image: url('kiosk/assets/bg_scifi.png') 0 0 0 0 stretch stretch;
}

/* --- Headers (Keep Orbitron for that Sci-Fi feel) --- */
/* --- Headers (Clean Roboto) --- */
QLabel#HoloHeader {
    font-family: 'Roboto', sans-serif;
    font-size: 36px;
    font-weight: bold;
    color: #00E5FF; /* Keep accent color for numbers */
}

QLabel#CardTitle {
    font-family: 'Roboto', sans-serif;
    font-size: 28px;
    font-weight: bold;
    color: #FFFFFF; 
}

/* Headings inside cards */
QLabel#QuestHeading {
    font-family: 'Roboto', sans-serif;
    font-size: 24px;
    font-weight: bold;
    color: #FFFFFF;
    margin-bottom: 5px;
}

QLabel#QuestDesc {
    font-size: 16px;
    color: #B0BEC5; /* Slightly muted white/grey */
}

/* --- Panels (Glassmorphism) --- */
/* Matches Web Admin: rgba(0, 20, 40, 0.8) */
QFrame#HoloFrameBody {
    background-color: rgba(0, 20, 40, 200); 
    border: 1px solid rgba(0, 229, 255, 100);
    border-radius: 8px;
}

/* Tables */
QTableWidget {
    background-color: rgba(0, 20, 40, 200);
    border: 1px solid rgba(0, 229, 255, 80);
    gridline-color: rgba(0, 229, 255, 40);
    color: #FFFFFF;
    selection-background-color: rgba(0, 229, 255, 50);
}
QHeaderView::section {
    background-color: rgba(0, 10, 20, 240);
    color: #00E5FF;
    border: none;
    padding: 8px;
    font-family: 'Orbitron';
    font-weight: bold;
}

/* ScrollBars */
QScrollBar:vertical {
    border: 1px solid #004488;
    background: #0A0A12;
    width: 20px;
    margin: 4px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #00E5FF;
    min-height: 20px;
    border-radius: 2px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

/* Tooltips */
QToolTip {
    border: 1px solid #00E5FF;
    background-color: rgba(0, 20, 40, 240);
    color: #00E5FF;
}
